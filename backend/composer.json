{
  "name": "vinod2244/transport-connect",
  "description": "AP Transport Connect - Production Ready Transport Marketplace Platform",
  "type": "project",
  "license": "proprietary",
  "authors": [
    {
      "name": "Vinod Kumar",
      "email": "vinod.kumarg@outlook.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "firebase/php-jwt": "^6.10",
    "phpmailer/phpmailer": "^6.9",
    "vlucas/phpdotenv": "^5.5",
    "monolog/monolog": "^3.4",
    "psr/log": "^3.0",
    "psr/http-message": "^2.0",
    "guzzlehttp/guzzle": "^7.7",
    "firebase/php-sdk": "^6.6",
    "razorpay/razorpay": "^2.8",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-pdo": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "friendsofphp/php-cs-fixer": "^3.49",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "config/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "start": "php -S localhost:8000 -t public/",
    "test": "phpunit",
    "format": "php-cs-fixer fix",
    "lint": "phpstan analyse"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist"
  }
}
